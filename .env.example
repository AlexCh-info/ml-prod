# Пример переменных окружения. Скопируй в .env (он не попадает в git) и замени все change-me.
#   cp .env.example .env
# Этот файл читают ДВА потребителя:
#   1) docker compose — переменные без префикса (подстановка ${VAR} в docker-compose.yml);
#   2) приложение taxi — только TAXI__<СЕКЦИЯ>__<ПОЛЕ> (env имеет приоритет над configs/*.yaml).

# ============================ docker compose: стенд core ============================

# --- Postgres: суперпользователь (только для init-скриптов и администрирования) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres

# --- Postgres: отдельные пользователи и базы для сервисов (создаются infra/postgres/init.sql) ---
MLFLOW_DB_USER=mlflow
# Подставляется в URI postgresql://user:pass@host: только [A-Za-z0-9._~-], иначе URI сломается.
MLFLOW_DB_PASSWORD=change-me-mlflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-airflow

# --- RustFS (S3): корневые ключи. Ими пользуются MLflow server и rustfs-init.
# Не оставляй дефолт rustfsadmin: entrypoint RustFS предупреждает о нём, а пустое значение — ошибка старта.
RUSTFS_ACCESS_KEY=rustfsadmin-local
RUSTFS_SECRET_KEY=change-me-rustfs

# --- Порты на хосте (слева в "HOST:CONTAINER"). 5000 на macOS занят AirPlay → MLflow на 5001 ---
POSTGRES_PORT=5432
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001
MLFLOW_PORT=5001
REDIS_PORT=6379

# ============================ приложение taxi (TAXI__*) ============================

# Путь к YAML-конфигу (по умолчанию configs/base.yaml)
# TAXI_CONFIG=configs/base.yaml

# Логирование: text локально, json в контейнерах
# TAXI__LOGGING__LEVEL=INFO
# TAXI__LOGGING__FORMAT=text

# S3 (RustFS) для клиентов с хоста: DVC remote (этап 02), чтение s3://lake.
# MLflow-клиенту ключи НЕ нужны: артефакты идут через MLflow server (proxied artifacts).
# TAXI__S3__ACCESS_KEY_ID=rustfsadmin-local
# TAXI__S3__SECRET_ACCESS_KEY=change-me-rustfs
